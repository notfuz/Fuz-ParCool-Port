# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!gradlew
!gradlew.bat

# Architectury / Loom
.architectury-transformer/
**/explodedCommon/
**/loom-cache/

# Minecraft dev environment (generated by the run tasks).
# Every loader module declares up to four run directories - `run` and `run-client2` on both
# :fabric and :neoforge, plus `run-server` on :neoforge - and each of them holds saves, logs,
# telemetry, options.txt and a .mixin.out export. The `**/` prefix is what makes this cover the
# per-module copies rather than only the ones at the repository root; a bare `run/` did not, and
# 16 MB of run-client2 was about to be committed.
/run/
/run-server/
/run-client/
/run-client2/
**/run/
**/run-server/
**/run-client/
**/run-client2/
**/.mixin.out/

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
bin/
out/

# OS
.DS_Store
Thumbs.db
.directory

# Release artifacts. The root rule is deliberately a `/*.jar` and not `*.jar`: it keeps the two
# release jars the maintainer drops in the root out of the index, while the Gradle wrapper jar
# under gradle/wrapper/ stays tracked (it is re-added by the rule above).
/*.jar

# The per-module build/ directories are already covered by the `build/` rule, but a stray jar
# dropped next to a module's build.gradle would not be, so name the distribution outputs too.
common/build/libs/
fabric/build/libs/
neoforge/build/libs/
*.class
*.log

# Dumps of a game session, pasted into the repository root while debugging. They carry the local
# path layout, the player name and the whole resource-reload noise, and are of no use to anyone
# reading the port.
*.txt
